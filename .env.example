# SPDX-License-Identifier: AGPL-3.0-or-later
# Echte Moodle-Basisadresse (ggf. mit Installationspfad), z. B. https://moodle.example.edu
MOODLE_BASE_URL=
MOODLE_ENABLED=true
# Für Coburg: hs-coburg; veröffentlichte Profile: unios profiles list
INSTITUTION_SLUG=generic
# Wird mit scripts/setup_token.py bevorzugt in der System-Keychain abgelegt.
# Nur falls kein geeigneter Schlüsselspeicher verfügbar ist: .env-Fallback
# (Unix: Rechte 600; Windows: ACL nur für das aktuelle Benutzerkonto).
MOODLE_TOKEN=
DATA_DIR=./data
# Die Live-Datenbank und Logs bleiben lokal; LOCAL_DIR nie mit Syncthing spiegeln.
LOCAL_DIR=./local
# Nur für den gebauten Hintergrunddienst; die lokale Vite-Vorschau bleibt auf 5173.
SERVE_REACT=false
REACT_DIST_DIR=./frontend/dist
# Optionaler Anzeigename für den Host (Standard: Computername).
DEVICE_NAME=
HOST_HEARTBEAT_SECONDS=300
# Für automatische Ausfallübernahme auf beiden Host-Geräten eine eigene
# Tailscale-Serve-Adresse eintragen, z. B. https://geraet.tailnet.ts.net/health.
# Ohne Adresse bleibt die automatische Übernahme gesperrt.
HOST_HEALTH_URL=
# Erlaubte Host-Header, durch Komma getrennt (Ports werden ignoriert); schützt vor
# DNS-Rebinding. Die Tailscale-Serve-Adresse dieses Geräts hier ergänzen,
# z. B. 127.0.0.1,localhost,[::1],geraet.tailnet.ts.net.
ALLOWED_HOSTS=127.0.0.1,localhost,[::1]
# Verlangt für /api und /calendar.ics eine gekoppelte Geräte-Sitzung. Der eigene
# Browser auf 127.0.0.1/localhost koppelt sich automatisch; andere Geräte mit
# `unios pair` koppeln. Nur zu Testzwecken ausschalten.
API_AUTH_REQUIRED=true
AUTOMATIC_TAKEOVER_ENABLED=true
AUTOMATIC_TAKEOVER_AFTER_SECONDS=7200
AUTOMATIC_TAKEOVER_SNAPSHOT_MAX_AGE_SECONDS=10800
AUTOMATIC_TAKEOVER_POLL_SECONDS=60
SNAPSHOT_INTERVAL_SECONDS=900
SNAPSHOT_KEEP=20
# Optionaler Override für einen abweichenden SQLite-Pfad.
DATABASE_URL=
TZ=Europe/Berlin
SYNC_INTERVAL_MINUTES=60
SYNC_JITTER_MINUTES=5
STALE_SYNC_HOURS=24
QUIET_HOURS_START=1
QUIET_HOURS_END=6
REQUEST_DELAY_SECONDS=0.5
NTFY_URL=
DISCORD_WEBHOOK_URL=
DEADLINE_WARNING_DAYS=7,3,1
# Bindung an die private Tailscale-IP erfolgt in docker-compose.yml.
TAILSCALE_IP=
# Syncthing-REST-API nur auf der lokalen Loopback-Adresse abfragen.
SYNCTHING_API_URL=http://127.0.0.1:8384
# Ordner-ID aus der Syncthing-Oberfläche; der Ordner muss DATA_DIR entsprechen.
SYNCTHING_FOLDER_ID=
# Lokaler Syncthing-API-Schlüssel. Die .env muss Rechte 600 haben.
SYNCTHING_API_KEY=
RESTIC_REPOSITORY=
RESTIC_PASSWORD=
# Nur für Docker Compose: lokaler Restic-Zielordner auf dem Host, gern eine externe Platte.
# Bei lokalem Ziel RESTIC_REPOSITORY=/app/backup setzen; für Cloud-Ziele dessen URL eintragen.
RESTIC_LOCAL_PATH=./backup
CURRENT_SEMESTER_NAME=Semester_1
MAX_ANKI_CANDIDATES_PER_RESOURCE=15
# Eigener zufälliger Token für den lokalen Anki-Agenten; leer = API deaktiviert.
ANKI_AGENT_TOKEN=
# MCP ist explizit aus. Für Aktivierung starken eigenen Token setzen.
MCP_ENABLED=false
MCP_TOKEN=
# Optionaler getrennter MCP-Fernzugriff. Nur dessen Port später durch einen HTTPS-Tunnel veröffentlichen.
# Die PIN muss mindestens 12 zufällige Ziffern haben und bleibt nur auf dem Host.
REMOTE_MCP_PUBLIC_URL=
REMOTE_MCP_APPROVAL_PIN=
# Optional: Fine-grained GitHub-Token nur für ausgewählte Projekt-Repositories.
# Leserechte: Contents, Issues und Pull requests. Nie in DATA_DIR speichern.
GITHUB_TOKEN=
# Die optionale Git-Spiegelung verwendet die lokale Git-Anmeldung (z. B. Git Credential Manager),
# nicht GITHUB_TOKEN. Für private Repos dort ebenfalls nur Leserechte einrichten.
# Mindestdatenmengen für den Lernstand, darunter erscheint "Zu wenig Daten".
LEARNING_MIN_REVIEWS=5
LEARNING_MIN_ATTEMPTS=3
# Lernblöcke vor Prüfungen: Vorlauf in Tagen und feste Blockgröße in Minuten.
STUDY_BLOCK_LOOKAHEAD_DAYS=14
STUDY_BLOCK_MINUTES=45
# Optionaler KI-Adapter (Stufe 3, standardmäßig aus). Ohne eigenen Schlüssel bleibt er inaktiv.
# Aktuell wird nur Anthropic unterstützt; dafür lokal "uv sync --extra ai" ausführen.
AI_ADAPTER_ENABLED=false
AI_ADAPTER_MONTHLY_BUDGET_TOKENS=
AI_ADAPTER_API_KEY=
# Normalerweise nicht nötig: Schlüssel einfügen und Modell auswählen geht in der App (KI-Seite).
# Hier nur setzen, wenn ein Server ohne Oberfläche läuft.
AI_ADAPTER_MODEL=
# Obergrenze für Antwort-Tokens; zählt beim Monatsbudget als Reservierung im schlechtesten Fall mit.
AI_ADAPTER_MAX_OUTPUT_TOKENS=16000
# Optional: low, medium oder high. Leer lässt den API-Standard des Modells gelten; höherer Aufwand
# kostet mehr Tokens, ist also ebenfalls Marcs Kostenentscheidung.
AI_ADAPTER_EFFORT=
# Optionaler RFC-3161-Zeitstempel für Abgabearchive. Leer = deaktiviert; HTTPS-Adresse einer TSA eintragen.
SUBMISSION_TSA_URL=
# Optionale lokal installierte Hochschul-Konnektoren, durch Komma getrennt. Leer = keine Plug-ins.
CONNECTOR_PLUGINS=
