{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node node_modules/typescript-native/bin/tsc -b && vite build --configLoader native",
    "lint": "eslint .",
    "preview": "vite preview --configLoader native",
    "typecheck": "node node_modules/typescript-native/bin/tsc -b",
    "test": "vitest run src",
    "api:generate": "openapi-typescript openapi.json -o src/generated/api.d.ts",
    "api:check": "node scripts/check-api-types.mjs",
    "i18n:new": "node --experimental-strip-types --no-warnings scripts/i18n-new.mjs",
    "i18n:check": "node --experimental-strip-types --no-warnings scripts/i18n-check.mjs",
    "e2e": "npm run build && playwright test",
    "e2e:run": "playwright test",
    "e2e:focused": "playwright test --config playwright.focused.config.ts",
    "e2e:handoff": "playwright test --config playwright.handoff.config.ts handoff.spec.ts",
    "generate-pwa-assets": "pwa-assets-generator --preset minimal-2023 public/favicon.svg"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource/fira-code": "5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.104.0",
    "@tanstack/react-query-persist-client": "^5.104.0",
    "@tauri-apps/api": "2.12.0",
    "@tauri-apps/plugin-process": "2.4.0",
    "@tiptap/core": "3.31.4",
    "@tiptap/extension-code-block-lowlight": "3.31.4",
    "@tiptap/extension-drag-handle-react": "3.31.4",
    "@tiptap/extension-link": "3.31.4",
    "@tiptap/extension-list": "3.31.4",
    "@tiptap/extension-placeholder": "3.31.4",
    "@tiptap/extension-table": "3.31.4",
    "@tiptap/markdown": "3.31.4",
    "@tiptap/pm": "3.31.4",
    "@tiptap/react": "3.31.4",
    "@tiptap/starter-kit": "3.31.4",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "diff": "^9.0.0",
    "docx-preview": "0.4.1",
    "dompurify": "^3.4.16",
    "i18next": "^26.4.2",
    "i18next-resources-to-backend": "^1.2.3",
    "idb-keyval": "^6.3.0",
    "jszip": "3.10.2",
    "katex": "0.19.0",
    "lowlight": "3.3.0",
    "lucide-react": "^1.48.0",
    "mathlive": "0.111.0",
    "monaco-editor": "0.57.0",
    "radix-ui": "^1.7.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0.15",
    "react-pdf": "^11.0.0",
    "react-router-dom": "^7.18.4",
    "tailwindcss": "^4.3.3",
    "ts-fsrs": "^5.4.2",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vite-pwa/assets-generator": "^1.0.4",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.11.0",
    "eslint-plugin-i18next": "^6.1.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "jsdom": "^30.1.1",
    "lighthouse": "^13.5.0",
    "openapi-typescript": "7.13.0",
    "oxlint": "^1.87.0",
    "prettier": "^3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.71.1",
    "typescript-native": "npm:typescript@^7.0.2",
    "vite": "^8.3.2",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.3"
  },
  "license": "AGPL-3.0-or-later",
  "overrides": {
    "dompurify": "$dompurify"
  }
}
