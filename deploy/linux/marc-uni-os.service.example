[Unit]
Description=UniOS
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
Environment="PATH=PROJECT_PATH"
ExecStart="PROJECT_PYTHON" "PROJECT_ROOT/scripts/run_service.py"
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
