{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "UniOS",
  "version": "0.1.31",
  "identifier": "app.unios.desktop",
  "build": {
    "frontendDist": "../splash"
  },
  "app": {
    "windows": [{
      "label": "main",
      "create": false,
      "title": "UniOS",
      "url": "index.html",
      "width": 1300,
      "height": 820,
      "minWidth": 740,
      "minHeight": 540,
      "visible": false
    }],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "externalBin": ["binaries/uniosd"],
    "resources": {
      "vendor/glib/LICENSE": "licenses/GLib-MIT.txt",
      "vendor/glib/COPYRIGHT": "licenses/GLib-COPYRIGHT.txt"
    },
    "icon": ["icons/v2/icon.png", "icons/v2/icon.ico", "icons/v2/icon.icns"],
    "shortDescription": "Dein lokaler Studienplatz",
    "category": "Education"
  },
  "plugins": {
    "deep-link": { "desktop": { "schemes": ["marcunios"] } }
  }
}
